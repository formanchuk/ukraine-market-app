{
  "name": "uamo-android",
  "version": "1.0.0",
  "description": "UAMO - Українська платформа для купівлі та продажу",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:web",
    "build:web": "cp -r ../uamo-web/* www/",
    "sync": "npx cap sync",
    "open:android": "npx cap open android",
    "build:android": "npx cap copy android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^5.7.0",
    "@capacitor/core": "^5.7.0",
    "@capacitor/camera": "^5.0.7",
    "@capacitor/filesystem": "^5.1.4",
    "@capacitor/push-notifications": "^5.0.10",
    "@capacitor/keyboard": "^5.0.6",
    "@capacitor/status-bar": "^5.0.6",
    "@capacitor/splash-screen": "^5.0.6",
    "@capacitor/share": "^5.0.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.7.0"
  }
}
